                <div className="stat-icon">📋</div>
                <div className="stat-content">
                  <h3>Yêu cầu đang xử lý</h3>
                  <div className="stat-number">{statsData.processing}</div>
                </div>
              </div>

              <div 
                className="stat-card completed"
                onClick={() => handleCardClick('completed')}
